<?xml version="1.0" encoding="UTF-8"?>
<manifest>
        <remote name="raymo200915-github" fetch="https://github.com/raymo200915" />
        <remote name="rise-gitlab" fetch="https://gitlab.com/riseproject" />

        <include name="common.xml" />

        <!-- Replace common.xml defaults with the current RISC-V working repos -->
        <remove-project path="optee_os"      name="OP-TEE/optee_os.git" />
        <remove-project path="optee_test"    name="OP-TEE/optee_test.git" />
        <remove-project path="linux"         name="linaro-swg/linux.git" />

        <project path="build"                name="optee_build.git"                 remote="raymo200915-github" revision="rp022-m2">
                <linkfile src="qemu_riscv64.mk" dest="build/Makefile" />
        </project>
        <project path="optee_os"             name="optee_os.git"                    remote="raymo200915-github" revision="rp022-m2" />
        <project path="optee_test"           name="optee_test.git"                  remote="raymo200915-github" revision="rp022-m2" />
        <project path="linux"                name="riscv-optee/linux.git"           remote="rise-gitlab"        revision="rp022-m2" />

        <!-- RISC-V QEMU platform dependencies -->
        <project path="opensbi"              name="opensbi_riscv.git"               remote="raymo200915-github" revision="rp022-m2" />
        <project path="qemu"                 name="qemu/qemu.git"                   revision="refs/tags/v10.0.0" clone-depth="1" />
        <project path="u-boot"               name="riscv-optee/u-boot.git"          remote="rise-gitlab"        revision="rise" />
</manifest>
